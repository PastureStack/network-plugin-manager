#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root_dir="$(cd "${script_dir}/.." && pwd)"
source "${script_dir}/version"
cd "${root_dir}"

arch=${ARCH:?'ARCH not set'}
suffix=""
[[ "${arch}" == amd64 ]] || suffix="_${arch}"
tag=${TAG:-${IMAGE_VERSION}${suffix}}
repo=${REPO:-ghcr.io/${IMAGE_NAMESPACE:-pasturestack}}
image="${repo}/network-plugin-manager:${tag}"
revision=${IMAGE_REVISION:-$(git rev-parse HEAD)}
source_epoch=${SOURCE_DATE_EPOCH:-$(git show -s --format=%ct HEAD)}
created=${IMAGE_CREATED:-$(date -u -d "@${source_epoch}" '+%Y-%m-%dT%H:%M:%SZ')}

[[ -s bin/network-plugin-manager ]] || "${script_dir}/build"
mkdir -p dist
DOCKER_BUILDKIT=${DOCKER_BUILDKIT:-1} docker build \
    --network "${DOCKER_BUILD_NETWORK:-host}" \
    --build-arg "IMAGE_VERSION=${tag}" \
    --build-arg "IMAGE_REVISION=${revision}" \
    --build-arg "IMAGE_CREATED=${created}" \
    --build-arg "SOURCE_DATE_EPOCH=${source_epoch}" \
    --build-arg "ALPINE_BRANCH=3.23" \
    -t "${image}" -f package/Dockerfile .
docker run --rm --network none --entrypoint iptables-legacy "${image}" --version | grep -Fq '(legacy)'
printf '%s\n' "${image}" > dist/images
printf 'Built %s\n' "${image}"
