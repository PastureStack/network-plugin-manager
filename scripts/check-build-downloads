#!/usr/bin/env bash
set -euo pipefail

root_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${root_dir}"

fail() { printf 'NETWORK_PLUGIN_MANAGER_POLICY_FAIL %s\n' "$*" >&2; exit 1; }
require_fixed() { grep -Fq -- "$2" "$1" || fail "$3"; }
reject_pattern() { if grep -Eq -- "$2" "$1"; then fail "$3"; fi; }
lock_value() { awk -F '\t' -v key="$1" '$1 == key {print $2}' build-inputs.lock.tsv; }
require_lock() { [[ "$(lock_value "$1")" == "$2" ]] || fail "lock_$1"; }

bash -n scripts/build scripts/check-build-downloads scripts/ci scripts/entry scripts/package scripts/release scripts/test scripts/validate scripts/verify-licenses scripts/version \
    package/start.sh package/platform-entrypoint.sh package/update-platform-ca alpine-apk.lock

awk -F '\t' 'NR==1 {ok=($1=="key" && $2=="value" && NF==2); next} NF!=2 || $1!~/^[a-z0-9_]+$/ || $2=="" || seen[$1]++ {ok=0} END {exit ok?0:1}' \
    build-inputs.lock.tsv || fail invalid_lock_tsv
require_lock schema pasturestack.network-plugin-manager-build/v3
require_lock golang_image golang:1.27.0-bookworm@sha256:484ef6066fa69acb059fdfeda7ba2b8f7391f2ef6abc6f9b8411e669ebd56466
require_lock docker_cli_image docker:29.7.2-cli@sha256:000bb62ff495f986c9f5578eb67cc2cb98b91138eda81d7762d5371eb8a497fe
require_lock alpine_image alpine:3.23@sha256:1beb0dc0a51de7ff38e3b5274078a2e0b81113ba5c7535e1a03d5913a5edbda3
require_lock alpine_branch 3.23
require_lock trivy_image ghcr.io/aquasecurity/trivy:0.74.0@sha256:62b1e65e8869bc4b4c6aa4fa2b21595256c7c2f6018a9d9ad61caf87187c1969

require_fixed go.mod $'go 1.26.0' go_language_floor
require_fixed go.mod $'toolchain go1.27.0' go_toolchain
require_fixed Dockerfile.dapper "FROM $(lock_value docker_cli_image) AS docker-cli" dapper_docker_image
require_fixed Dockerfile.dapper "FROM $(lock_value golang_image)" dapper_go_image
require_fixed package/Dockerfile "FROM $(lock_value alpine_image)" runtime_base
require_fixed package/Dockerfile '"curl=${ALPINE_APK_CURL_VERSION}"' runtime_curl_pin
require_fixed package/Dockerfile '"jq=${ALPINE_APK_JQ_VERSION}"' runtime_jq_pin
require_fixed scripts/package 'docker build \' bounded_image_build
reject_pattern scripts/package 'buildx (create|rm)|builder prune' custom_builder_removed
reject_pattern package/Dockerfile 'COPY bin/docker|/usr/bin/docker' runtime_docker_cli_removed
require_fixed binexec/watcher.go 'curl -fsS --max-time 10 --unix-socket' bounded_socket_client
reject_pattern binexec/watcher.go 'docker (ps|inspect)' generated_docker_cli_call
bash scripts/verify-licenses

for stale in trash.conf vendor.lock toolchain/buildx-security.patch; do
    [[ ! -e "${stale}" ]] || fail "stale_${stale}"
done
if grep -R -n -E 'github.com/docker/engine-api|github.com/fsouza/go-dockerclient|github.com/rancher/(cniglue|event-subscriber)|github.com/docker/docker/pkg/locker' \
    --include='*.go' --exclude-dir=vendor .; then
    fail obsolete_source_dependency
fi

while IFS= read -r workflow; do
    if grep -E '^[[:space:]]*uses:' "${workflow}" | grep -Ev '@[0-9a-f]{40}([[:space:]]*(#.*)?)?$'; then
        fail "unpinned_action:${workflow}"
    fi
done < <(find .github/workflows -type f \( -name '*.yml' -o -name '*.yaml' \) -print | LC_ALL=C sort)
reject_pattern .github/workflows/supply-chain.yml 'docker[[:space:]]+push|push:[[:space:]]+true|gh[[:space:]]+release|docker/login-action' ci_can_publish
require_fixed .github/workflows/supply-chain.yml 'govulncheck -show verbose ./...' govulncheck_gate
require_fixed .github/workflows/supply-chain.yml 'source-security.json' source_scan
require_fixed .github/workflows/supply-chain.yml 'binary-security.json' binary_scan
require_fixed .github/workflows/supply-chain.yml 'image-security.json' image_scan
require_fixed .github/workflows/supply-chain.yml 'image.cdx.json' image_sbom

printf 'NETWORK_PLUGIN_MANAGER_POLICY_OK language_floor=1.26.0 toolchain=1.27.0 modules=1 docker_sdk=moby-v29 cni=1.3 runtime_docker_cli=0 custom_builder=0 scans=source,binary,image\n'
